# Server Configuration
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/weather_tracking?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/weather_tracking?retryWrites=true&w=majority

# CORS Configuration (optional - defaults to * if omitted)
# Set to your deployed frontend domain in production (e.g., https://your-app.vercel.app)
# Multiple origins can be comma-separated
FRONTEND_URL=http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
